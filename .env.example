# Browser / SSR (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (optional — admin scripts / bypass RLS; never expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# External integrations — protects GET /api/v1/branches|orders|ping when set (header x-api-key or Bearer)
INTEGRATION_API_KEY=

# App URL (optional — emails, QR payloads, webhooks)
NEXT_PUBLIC_APP_URL=http://localhost:3000
